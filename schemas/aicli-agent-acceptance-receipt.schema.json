{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/aicli-agent-acceptance-receipt.schema.json",
  "title": "AICLI Agent and acceptance receipt",
  "description": "Receipt-only identity and one-task capability evidence. The Toolkit never derives these fields from model text.",
  "type": "object",
  "required": [
    "receipt_schema",
    "receipt_id",
    "source",
    "requested",
    "effective",
    "attested",
    "acceptance"
  ],
  "properties": {
    "receipt_schema": {
      "const": "aicli.agent.acceptance-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source": {
      "type": "object",
      "required": ["kind", "entry_sha256", "version"],
      "properties": {
        "kind": {"const": "aicli"},
        "entry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requested": {"$ref": "#/$defs/binding"},
    "effective": {"$ref": "#/$defs/binding"},
    "attested": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {
          "type": "object",
          "required": ["request_id", "response_model", "reasoning_items"],
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "response_model": {"type": "string", "minLength": 1},
            "reasoning_items": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "required": [
        "task_kind",
        "task_contract_sha256",
        "verifier",
        "completion_state",
        "cleanup_confirmed"
      ],
      "properties": {
        "task_kind": {"const": "nontrivial_agent"},
        "task_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "verifier": {
          "type": "object",
          "required": ["id", "sha256", "passed"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "passed": {"const": true}
          },
          "additionalProperties": false
        },
        "completion_state": {"const": "completed"},
        "cleanup_confirmed": {"const": true},
        "stability": {"enum": ["not_required", "not_run", "passed", "failed"]},
        "stress": {"enum": ["not_required", "not_run", "passed", "failed"]}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "model",
        "provider_id",
        "endpoint",
        "wire",
        "reasoning",
        "approval_policy",
        "sandbox_policy"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "wire": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1},
        "approval_policy": {"type": "string", "minLength": 1},
        "sandbox_policy": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
