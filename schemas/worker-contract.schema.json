{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/worker-contract.schema.json",
  "title": "Local asynchronous worker envelope",
  "description": "A fail-closed non-native local Codex worker envelope. It is never a native subagent request.",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "fresh_execution",
    "read_roots",
    "write_root",
    "expected_artifacts",
    "acceptance",
    "constraints",
    "request",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "llm-backend-toolkit.local-async-worker-envelope.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fresh_execution": {
      "const": true,
      "description": "The adapter submits with force=true and forbids a cache key."
    },
    "read_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "write_root": {"type": "string", "minLength": 1},
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["deterministic", "verifier"],
      "properties": {
        "deterministic": {"const": true},
        "verifier": {
          "type": "object",
          "required": ["id", "sha256"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": [
        "external_effects",
        "protected_actions",
        "highest_authority",
        "delegation",
        "sandbox"
      ],
      "properties": {
        "external_effects": {"const": "return_to_sol"},
        "protected_actions": {"const": "return_to_sol"},
        "highest_authority": {"const": "not_inherited"},
        "delegation": {"const": "forbidden"},
        "sandbox": {"const": "workspace-write"},
        "network": {"const": "forbidden"},
        "search": {"const": "disabled"}
      },
      "additionalProperties": false
    },
    "request": {
      "$ref": "request.schema.json"
    },
    "bindings": {
      "type": "object",
      "required": [
        "backend_alias",
        "artifact_digest",
        "parent_model",
        "quantization",
        "tokenizer",
        "chat_template",
        "harness",
        "profile",
        "aicli",
        "codex_event_protocol",
        "serving_engine",
        "toolkit_source_sha256",
        "broker",
        "context",
        "reasoning"
      ],
      "properties": {
        "backend_alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "fallback_used": {"type": "boolean"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "parent_model": {"type": "string", "minLength": 1},
        "parent_model_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_layer_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "parameters_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "quantization": {"type": "string", "minLength": 1},
        "tokenizer": {"type": "string", "minLength": 1},
        "chat_template": {"type": "string", "minLength": 1},
        "harness": {"const": "codex-cli"},
        "profile": {"type": "string", "minLength": 1},
        "profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_id": {"type": "string", "minLength": 1},
        "wire": {"type": "string", "minLength": 1},
        "aicli": {
          "type": "object",
          "required": ["entry_sha256", "version"],
          "properties": {
            "entry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "version": {"type": "string", "minLength": 1},
            "codex_cli_version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "codex_event_protocol": {"const": "aicli.machine-event.v1"},
        "serving_engine": {"const": "ollama"},
        "toolkit_source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "broker": {
          "type": "object",
          "required": ["id", "lease_id", "serialization"],
          "properties": {
            "id": {"const": "LocalGpuBroker"},
            "lease_id": {"type": "string", "minLength": 1},
            "serialization": {"const": "exclusive"}
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": ["total_tokens", "reserved_output_tokens"],
          "properties": {
            "total_tokens": {"type": "integer", "minimum": 1024, "maximum": 1048576},
            "reserved_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1048575}
          },
          "additionalProperties": false
        },
        "reasoning": {
          "type": "object",
          "required": ["mode", "effort"],
          "properties": {
            "mode": {"const": "on"},
            "effort": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "legacy-local-default-data-factory",
      "description": "The compatibility route is exactly local-default through data_factory and codex-cli in an isolated workspace-write root.",
      "properties": {
        "request": {
          "type": "object",
          "required": ["backend", "execution"],
          "properties": {
            "backend": {"const": "local-default"},
            "execution": {
              "type": "object",
              "required": ["mode", "runner", "policy", "budget"],
              "properties": {
                "mode": {"const": "agent"},
                "runner": {"const": "data_factory"},
                "policy": {"const": "workspace-write"},
                "budget": {"type": "object"}
              }
            }
          }
        },
        "bindings": {
          "type": "object",
          "properties": {
            "backend_alias": {"const": "local-default"},
            "context": {
              "type": "object",
              "properties": {
                "total_tokens": {"const": 262144},
                "reserved_output_tokens": {"const": 32768}
              }
            }
          }
        }
      }
    },
    {
      "title": "benchmark-only-exact-codex-cli",
      "description": "The runtime must re-resolve one exact non-cloud backend with routing_role=benchmark_only and cloud=false; schema shape alone never promotes another backend.",
      "properties": {
        "constraints": {
          "type": "object",
          "required": ["network", "search"],
          "properties": {
            "network": {"const": "forbidden"},
            "search": {"const": "disabled"}
          }
        },
        "request": {
          "type": "object",
          "required": ["backend", "execution"],
          "properties": {
            "backend": {"not": {"const": "local-default"}},
            "execution": {
              "type": "object",
              "required": ["mode", "runner", "policy", "budget"],
              "properties": {
                "mode": {"const": "agent"},
                "runner": {"const": "codex-cli"},
                "policy": {"const": "workspace-write"},
                "budget": {
                  "type": "object",
                  "required": ["limit_mode", "timeout_seconds"],
                  "properties": {
                    "limit_mode": {"const": "watchdog_only"},
                    "timeout_seconds": {"const": 7200}
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "type": "object",
          "required": [
            "fallback_used",
            "parent_model_digest",
            "model_layer_digest",
            "parameters_digest",
            "profile_fingerprint",
            "provider_id",
            "wire"
          ],
          "properties": {
            "backend_alias": {"not": {"const": "local-default"}},
            "fallback_used": {"const": false},
            "parent_model_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "model_layer_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "parameters_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "provider_id": {"type": "string", "minLength": 1},
            "wire": {"const": "responses"},
            "aicli": {
              "type": "object",
              "required": ["codex_cli_version"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
