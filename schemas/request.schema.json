{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/request.schema.json",
  "title": "LLM Backend Toolkit Request",
  "type": "object",
  "required": ["task"],
  "properties": {
    "backend": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "deprecated": true
    },
    "task": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "instructions": {"type": "array"},
        "inputs": {"type": "array"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "expected_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "Optional caller-declared digest of the exact bytes the async worker must consume."
              },
              "expected_bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional caller-declared byte size paired with expected_sha256."
              },
              "top_k": {"type": "integer", "minimum": 1},
              "max_chars": {"type": "integer", "minimum": 256}
            },
            "dependentRequired": {
              "expected_sha256": ["expected_bytes"],
              "expected_bytes": ["expected_sha256"]
            },
            "additionalProperties": false
          }
        },
        "expected_output": {
          "type": "object",
          "properties": {
            "format": {"enum": ["text", "json"]},
            "required_keys": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["compact", "passthrough"], "default": "compact"},
        "target_tokens": {"type": "integer", "minimum": 16},
        "pinned": {"type": "array"}
      },
      "additionalProperties": false
    },
    "reasoning": {
      "type": "object",
      "description": "Thinking is opt-in. Hidden reasoning is never returned or persisted; only public output and safe progress metadata are exposed.",
      "properties": {
        "mode": {"enum": ["off", "on"], "default": "off"}
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["auto", "native", "specialist"], "default": "auto"},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "kind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "expected_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "Optional caller-declared digest of the exact bytes the async worker must consume."
              },
              "expected_bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional caller-declared byte size paired with expected_sha256."
              },
              "kind": {"enum": ["image", "audio"]},
              "route": {"enum": ["auto", "native", "specialist"]},
              "purpose": {"type": "string"}
            },
            "dependentRequired": {
              "expected_sha256": ["expected_bytes"],
              "expected_bytes": ["expected_sha256"]
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "cloud_allowed": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly permits task text, selected source excerpts, and media to be sent to the chosen cloud provider."
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "description": "Caller-declared public presentation metadata. It is shown in the local observer and is never inferred from the private task prompt.",
      "properties": {
        "public_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Short non-sensitive title that is safe to display in persistent local history."
        },
        "file_changes": {
          "type": "object",
          "description": "Explicit opt-in for persistent relative paths and bounded text diffs. Every listed file must be caller-declared public-safe; omitted or unlisted files remain count-only.",
          "required": ["mode", "include"],
          "properties": {
            "mode": {
              "const": "diff"
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F\\u007F:]+$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["direct", "agent"], "default": "direct"},
        "runner": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "workspace": {"type": "string", "minLength": 1},
        "policy": {
          "enum": ["read-only", "workspace-write", "danger-full-access"],
          "default": "danger-full-access",
          "description": "Codex agent runs default to full local access. Use workspace-write or read-only only as an explicit restriction."
        },
        "cache_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,511}$",
          "description": "Caller-owned semantic identity. When present and valid, cache reuse ignores scheduling metadata but remains isolated by backend/model/route, privacy, reasoning, media, and output protocol."
        },
        "budget": {
          "type": "object",
          "properties": {
            "timeout_seconds": {
              "type": ["integer", "null"],
              "minimum": 30,
              "maximum": 86400,
              "description": "Total wall-clock timeout. Omitted watchdog-only requests are materialized as 900 seconds; legacy completion_driven requests require null."
            },
            "idle_timeout_seconds": {
              "anyOf": [
                {"const": 0},
                {"type": "integer", "minimum": 60, "maximum": 604800}
              ],
              "description": "Legacy renewable inactivity lease used only by explicit completion_driven jobs; 0 disables the lease. Current AICLI routes reject this legacy mode before launch."
            },
            "max_steps": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 200
            },
            "max_tool_calls": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 10000
            },
            "limit_mode": {
              "enum": ["completion_driven", "bounded", "watchdog_only"],
              "default": "watchdog_only",
              "description": "watchdog_only is the current AICLI-compatible default and uses timeout_seconds without step or tool-call cutoffs; bounded is explicit, while completion_driven is retained only for compatible legacy harnesses."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": ["limit_mode"],
                "properties": {"limit_mode": {"const": "watchdog_only"}}
              },
              "then": {
                "not": {
                  "anyOf": [
                    {"required": ["max_steps"]},
                    {"required": ["max_tool_calls"]}
                  ]
                }
              }
            },
            {
              "if": {
                "required": ["limit_mode"],
                "properties": {"limit_mode": {"const": "completion_driven"}}
              },
              "then": {
                "properties": {
                  "timeout_seconds": {"type": "null"},
                  "max_steps": {"type": "null"},
                  "max_tool_calls": {"type": "null"}
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "required": ["from_job_id"],
      "properties": {
        "from_job_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "max_turns": {"type": "integer", "minimum": 2, "maximum": 8}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
