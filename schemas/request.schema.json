{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/request.schema.json",
  "title": "LLM Backend Toolkit Request",
  "type": "object",
  "required": ["provider", "task"],
  "properties": {
    "provider": {
      "enum": ["qwen3.7-plus", "qwen-main-v1"]
    },
    "task": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "instructions": {"type": "array"},
        "inputs": {"type": "array"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "top_k": {"type": "integer", "minimum": 1},
              "max_chars": {"type": "integer", "minimum": 256}
            },
            "additionalProperties": false
          }
        },
        "expected_output": {
          "type": "object",
          "properties": {
            "format": {"enum": ["text", "json"]},
            "required_keys": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["compact", "passthrough"], "default": "compact"},
        "target_tokens": {"type": "integer", "minimum": 16},
        "pinned": {"type": "array"}
      },
      "additionalProperties": false
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["off", "on"], "default": "off"}
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["auto", "native", "specialist"], "default": "auto"},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "kind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["image", "audio"]},
              "route": {"enum": ["auto", "native", "specialist"]},
              "purpose": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "cloud_allowed": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly permits task text, selected source excerpts, and media to be sent to the chosen cloud provider."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["direct", "agent"], "default": "direct"},
        "runner": {
          "enum": ["data_factory", "codex-cli", "claude-code", "qwen-code", "opencode"]
        },
        "workspace": {"type": "string", "minLength": 1},
        "policy": {"enum": ["read-only", "workspace-write"], "default": "read-only"},
        "cache_key": {"type": "string", "minLength": 1},
        "budget": {
          "type": "object",
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 86400},
            "max_steps": {"type": "integer", "minimum": 1, "maximum": 200},
            "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 10000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
