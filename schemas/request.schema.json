{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/request.schema.json",
  "title": "LLM Backend Toolkit Request",
  "type": "object",
  "required": ["task"],
  "properties": {
    "backend": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "deprecated": true
    },
    "task": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "instructions": {"type": "array"},
        "inputs": {"type": "array"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "top_k": {"type": "integer", "minimum": 1},
              "max_chars": {"type": "integer", "minimum": 256}
            },
            "additionalProperties": false
          }
        },
        "expected_output": {
          "type": "object",
          "properties": {
            "format": {"enum": ["text", "json"]},
            "required_keys": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["compact", "passthrough"], "default": "compact"},
        "target_tokens": {"type": "integer", "minimum": 16},
        "pinned": {"type": "array"}
      },
      "additionalProperties": false
    },
    "reasoning": {
      "type": "object",
      "description": "Thinking is opt-in. Hidden reasoning is never returned or persisted; only public output and safe progress metadata are exposed.",
      "properties": {
        "mode": {"enum": ["off", "on"], "default": "off"}
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["auto", "native", "specialist"], "default": "auto"},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "kind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["image", "audio"]},
              "route": {"enum": ["auto", "native", "specialist"]},
              "purpose": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "cloud_allowed": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly permits task text, selected source excerpts, and media to be sent to the chosen cloud provider."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["direct", "agent"], "default": "direct"},
        "runner": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "workspace": {"type": "string", "minLength": 1},
        "policy": {"enum": ["read-only", "workspace-write"], "default": "read-only"},
        "cache_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,511}$",
          "description": "Caller-owned semantic identity. When present and valid, cache reuse ignores scheduling metadata but remains isolated by backend/model/route, privacy, reasoning, media, and output protocol."
        },
        "budget": {
          "type": "object",
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 86400},
            "max_steps": {"type": "integer", "minimum": 1, "maximum": 200},
            "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 10000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "required": ["from_job_id"],
      "properties": {
        "from_job_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "max_turns": {"type": "integer", "minimum": 2, "maximum": 8}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
