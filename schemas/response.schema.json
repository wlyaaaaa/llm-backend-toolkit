{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/response.schema.json",
  "title": "LLM Backend Toolkit Result",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "enum": ["ok", "partial", "blocked", "failed", "accepted", "running", "cache_hit"]
    },
    "output": {},
    "provider": {},
    "context_receipt": {"type": "object"},
    "source_receipt": {"type": "array"},
    "usage": {"type": "object"},
    "checks": {"type": "array"},
    "uncertainties": {"type": "array"},
    "artifacts": {"type": "array"},
    "media_routes": {"type": "array"},
    "error": {"type": "object"},
    "decision": {},
    "job_id": {"type": "string"},
    "job_status": {"type": "string"},
    "poll_after_ms": {"type": "integer"},
    "monitor_until_utc": {"type": "string"}
  },
  "additionalProperties": true
}
