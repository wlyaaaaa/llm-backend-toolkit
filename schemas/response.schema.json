{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/llm-backend-toolkit/schemas/response.schema.json",
  "title": "LLM Backend Toolkit Result",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "enum": ["ok", "partial", "blocked", "failed", "accepted", "running", "cache_hit"]
    },
    "output": {},
    "backend": {"type": "object"},
    "backend_catalog": {"type": "object"},
    "provider": {},
    "context_receipt": {"type": "object"},
    "delegation_receipt": {"type": "object"},
    "delivery_receipt": {"type": "object"},
    "source_receipt": {"type": "array"},
    "usage": {"type": "object"},
    "checks": {"type": "array"},
    "uncertainties": {"type": "array"},
    "artifacts": {"type": "array"},
    "media_routes": {"type": "array"},
    "execution_receipt": {"type": "object"},
    "cache_identity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "schema",
            "mode",
            "digest",
            "canonicalization",
            "caller_cache_key_hash",
            "backend",
            "model",
            "route",
            "profile"
          ],
          "properties": {
            "schema": {
              "const": "llm-backend-toolkit.explicit-cache-identity.v2"
            },
            "mode": {"const": "explicit"},
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "canonicalization": {
              "const": "stdlib-json-sort-compact-utf8-v1"
            },
            "caller_cache_key_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "backend": {"type": "string", "minLength": 1},
            "model": {"type": "string"},
            "route": {"type": ["string", "null"]},
            "profile": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "schema",
            "mode",
            "digest",
            "canonicalization"
          ],
          "properties": {
            "schema": {
              "const": "llm-backend-toolkit.explicit-cache-identity.v2"
            },
            "mode": {"const": "request_digest"},
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "canonicalization": {
              "const": "stdlib-json-sort-compact-utf8-v1"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "deprecated": true,
          "required": [
            "schema",
            "mode",
            "digest",
            "backend",
            "model",
            "route",
            "profile"
          ],
          "properties": {
            "schema": {
              "const": "llm-backend-toolkit.explicit-cache-identity.v1"
            },
            "mode": {"const": "explicit"},
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "backend": {"type": "string", "minLength": 1},
            "model": {"type": "string"},
            "route": {"type": ["string", "null"]},
            "profile": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "deprecated": true,
          "required": [
            "schema",
            "mode",
            "digest"
          ],
          "properties": {
            "schema": {
              "const": "llm-backend-toolkit.explicit-cache-identity.v1"
            },
            "mode": {"const": "request_digest"},
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "error": {"type": "object"},
    "decision": {},
    "job_id": {"type": "string"},
    "job_status": {"type": "string"},
    "poll_after_ms": {"type": "integer"},
    "recommended_check_utc": {"type": "string"},
    "conversation": {"type": "object"},
    "monitor_until_utc": {
      "type": ["string", "null"],
      "description": "Null for completion-driven jobs, which remain monitorable until completion or explicit cancellation."
    }
  },
  "additionalProperties": true
}
