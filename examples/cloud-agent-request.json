    "mode": "off"
  },
  "privacy": {
    "cloud_allowed": true
  },
  "execution": {
    "mode": "agent",
    "workspace": "C:/staging/job-001",
    "policy": "workspace-write",
    "cache_key": "raw-sha256:replace-with-real-input-hash",
    "budget": {
      "timeout_seconds": 900,
      "max_steps": 30,
      "max_tool_calls": 120
    }
  }
